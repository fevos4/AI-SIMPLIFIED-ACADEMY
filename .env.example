DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/elearning_db?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5433/elearning_db?schema=public"

# Storage configuration
STORAGE_PROVIDER="minio"
STORAGE_BUCKET="elearning"

# MinIO configuration (local dev)
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadminpassword"

# Backblaze B2 configuration (production)
B2_ENDPOINT="s3.us-west-004.backblazeb2.com"
B2_KEY_ID="your_b2_key_id"
B2_APPLICATION_KEY="your_b2_application_key"

# Authentication & Application
SESSION_SECRET="super-secret-jwt-key-at-least-32-characters-long"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="cron-secret-key"

# Email configuration
RESEND_API_KEY="re_123456789"

# CBE Bank details for student course purchase
CBE_ACCOUNT_NAME="AI Simplified Academy"
CBE_ACCOUNT_NUMBER="1000123456789"

# Branding & Contact
NEXT_PUBLIC_CONTACT_EMAIL="support@aisimplifiedacademy.com"
NEXT_PUBLIC_PLATFORM_NAME="AI Simplified Academy"
NEXT_PUBLIC_PLATFORM_TAGLINE="Empowering Students with World-Class E-Learning"
